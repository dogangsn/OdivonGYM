# Cloudflare static-asset headers (same cache rules as firebase.json "hosting.headers").
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/i18n/*
  Cache-Control: no-cache, no-store, must-revalidate
/ngsw-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
/ngsw.json
  Cache-Control: no-cache, no-store, must-revalidate
/safety-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
/worker-basic.min.js
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
/main-*.js
  Cache-Control: public, max-age=31536000, immutable
/polyfills-*.js
  Cache-Control: public, max-age=31536000, immutable
/chunk-*.js
  Cache-Control: public, max-age=31536000, immutable
/styles-*.css
  Cache-Control: public, max-age=31536000, immutable
