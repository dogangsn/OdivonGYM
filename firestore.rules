rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---- SPARK PLANI NOTU ----
    // Cloud Functions (1. VEYA 2. nesil, fark etmez) Firebase'de SADECE
    // Blaze planında deploy edilebiliyor — bu projenin planı Spark, o yüzden
    // Admin SDK / Custom Claims kullanamıyoruz. Bunun yerine rol/tenantId
    // burada, çağıranın KENDİ `users/{uid}` dokümanından `get()` ile
    // okunuyor. Bu bir okuma maliyeti getirir ama güvenlik açısından
    // Custom Claims'ten AŞAĞI değil: bu fonksiyon rules engine tarafından
    // sunucu tarafında değerlendirilir, client'ın gönderdiği payload'a asla
    // güvenmez (bkz. aşağıdaki `create`/`update` kuralları — `tenantId`
    // client'tan değil hep bu `get()`'ten gelir).
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myTenantId() {
      return myProfile().tenantId;
    }

    function isAdmin() {
      return hasProfile() && (myProfile().role == 'admin' || myProfile().role == 'owner');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function belongsToMyTenant(tenantId) {
      return hasProfile() && tenantId == myTenantId();
    }

    // ---- tenants/{tenantId} ----
    match /tenants/{tenantId} {
      // İş Kuralı 1: imzalı HERHANGİ biri yeni bir salon oluşturabilir — tek
      // başına zararsızdır, bir admin dokümanı eşlenmeden hiçbir işe
      // yaramaz. `ownerUid`, BU tenant'ın admin dokümanını SADECE onu yazabilir.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow read: if belongsToMyTenant(tenantId)
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if (isAdmin() && belongsToMyTenant(tenantId))
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow delete: if false;
    }

    // ---- users/{uid} ----
    match /users/{uid} {
      // Kural 3 (veri izolasyonu): bir üye sadece kendi dokümanını okur;
      // admin kendi salonundaki HERHANGİ bir dokümanı okuyabilir. Başka
      // salonun admin'i dahi bu satırı geçemez.
      allow read: if isOwner(uid) || (isAdmin() && belongsToMyTenant(resource.data.tenantId));

      allow create: if
        // (a) İş Kuralı 1 — kendi hesabın için, KENDİ oluşturduğun bir
        // salonun admin'i/sahibi olarak ilk kayıt.
        (isOwner(uid)
          && request.resource.data.uid == uid
          && (request.resource.data.role == 'admin' || request.resource.data.role == 'owner')
          && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId))
          && get(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.ownerUid == request.auth.uid)
        ||
        // (b) İş Kuralı 2 — bir admin, KENDİ salonuna yeni bir üye
        // ekliyor. `tenantId` client'ın gönderdiği değerden DEĞİL,
        // `myTenantId()` üzerinden admin'in kendi dokümanından okunur.
        (isAdmin()
          && request.resource.data.uid == uid
          && request.resource.data.role == 'user'
          && request.resource.data.tenantId == myTenantId());

      // Admin, kendi salonundaki bir üyeyi güncelleyebilir — ama `tenantId`
      // ve `role` ALANLARINI DEĞİŞTİREMEZ (bir üyeyi başka bir salona
      // taşımak ya da kendini/başkasını admin yapmak için update
      // kullanılamaz). Kullanıcı kendi dokümanında sadece görünen
      // ad/fotoğrafını değiştirir.
      // Ayrıca eski (tenantId'siz) admin hesaplarının kendi oluşturduğu tenant'a
      // bağlanmasına (self-healing) izin verilir.
      allow update: if (isAdmin()
            && belongsToMyTenant(resource.data.tenantId)
            && request.resource.data.tenantId == resource.data.tenantId
            && request.resource.data.role == resource.data.role)
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['displayName', 'photoURL', 'phone', 'gender', 'birthDate', 'country', 'language', 'membershipStatus', 'membershipStartsAt', 'membershipEndsAt', 'packageLabel', 'walletBalance', 'updatedAt']))
        || (isOwner(uid)
            && (!('tenantId' in resource.data) || resource.data.tenantId == null)
            && exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId))
            && get(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.ownerUid == request.auth.uid);

      allow delete: if isAdmin() && belongsToMyTenant(resource.data.tenantId);
    }


    // ---- Yardımcılar: feature koleksiyonları ----
    // `create`'te henüz kayıtlı doküman yok → `request.resource.data`;
    // `read/update/delete`'te mevcut doküman → `resource.data`.
    function ownCreate() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.tenantId == myTenantId();
    }

    function ownDoc() {
      return isOwner(resource.data.userId) && belongsToMyTenant(resource.data.tenantId);
    }

    // userId / tenantId sonradan değiştirilemez.
    function ownershipUnchanged() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.tenantId == resource.data.tenantId;
    }

    function adminCreate() {
      return isAdmin() && request.resource.data.tenantId == myTenantId();
    }

    function adminDoc() {
      return isAdmin() && belongsToMyTenant(resource.data.tenantId);
    }

    function tenantUnchanged() {
      return request.resource.data.tenantId == resource.data.tenantId;
    }

    // ---- Üyenin kendi verisi: üye tam CRUD, admin de salonu adına tam CRUD ----
    match /water_logs/{docId} {
      allow read: if ownDoc() || adminDoc();
      allow create: if ownCreate() || adminCreate();
      allow update: if (ownDoc() && ownershipUnchanged()) || (adminDoc() && tenantUnchanged());
      allow delete: if ownDoc() || adminDoc();
    }

    match /body_measurements/{docId} {
      allow read: if ownDoc() || adminDoc();
      allow create: if ownCreate() || adminCreate();
      allow update: if (ownDoc() && ownershipUnchanged()) || (adminDoc() && tenantUnchanged());
      allow delete: if ownDoc() || adminDoc();
    }

    match /workout_plans/{docId} {
      allow read: if ownDoc() || adminDoc();
      allow create: if ownCreate() || adminCreate();
      allow update: if (ownDoc() && ownershipUnchanged()) || (adminDoc() && tenantUnchanged());
      allow delete: if ownDoc() || adminDoc();
    }

    match /workout_templates/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /class_bookings/{docId} {
      allow read: if ownDoc() || adminDoc();
      allow create: if ownCreate();
      allow update: if (ownDoc() && ownershipUnchanged()) || (adminDoc() && tenantUnchanged());
      allow delete: if ownDoc() || adminDoc();
    }

    match /pt_appointments/{docId} {
      allow read: if ownDoc() || adminDoc();
      allow create: if ownCreate();
      allow update: if (ownDoc() && ownershipUnchanged()) || (adminDoc() && tenantUnchanged());
      allow delete: if ownDoc() || adminDoc();
    }

    match /member_documents/{docId} {
      allow read: if ownDoc() || adminDoc();
      allow create: if ownCreate() || adminCreate();
      allow update: if (ownDoc() && ownershipUnchanged()) || (adminDoc() && tenantUnchanged());
      allow delete: if ownDoc() || adminDoc();
    }

    // ---- Ödeme kayıtları: üye kendi hareketini oluşturabilir veya okuyabilir; admin tam yönetir ----
    match /wallet_transactions/{docId} {
      allow read: if ownDoc() || adminDoc();
      allow create: if ownCreate() || adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /user_packages/{docId} {
      allow read: if ownDoc() || adminDoc();
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    // ---- Salon verisi: üyeler okur, admin yönetir ----
    match /class_schedules/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      // Üye SADECE kontenjan sayacını (0..capacity) değiştirebilir — derse kayıt/iptal.
      allow update: if (adminDoc() && tenantUnchanged())
        || (belongsToMyTenant(resource.data.tenantId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBookings', 'updatedAt'])
            && request.resource.data.currentBookings >= 0
            && request.resource.data.currentBookings <= resource.data.capacity);
      allow delete: if adminDoc();
    }

    match /gym_packages/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /gym_branches/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /shop_products/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /gym_stock_categories/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /sports_disciplines/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /gym_facilities/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /gym_equipment/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    // ---- Sadece admin: satışlar ve muhasebe ----
    match /shop_sales/{docId} {
      allow read: if adminDoc();
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /accounting_entries/{docId} {
      allow read: if adminDoc();
      allow create: if adminCreate() || (isSignedIn() && request.resource.data.tenantId == myTenantId());
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /access_logs/{docId} {
      allow read: if adminDoc() || ownDoc();
      allow create: if adminCreate() || ownCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /gym_staff/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    match /gym_campaigns/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    // ---- gym_info/{tenantId}: salon başına tek doküman, doküman ID'si tenantId ----
    match /gym_info/{tenantId} {
      allow read: if belongsToMyTenant(tenantId);
      allow create: if isAdmin() && tenantId == myTenantId() && request.resource.data.tenantId == tenantId;
      allow update: if isAdmin() && tenantId == myTenantId() && request.resource.data.tenantId == tenantId;
      allow delete: if false;
    }

    // ---- gym_subscriptions/{tenantId}: salon SaaS lisans ve paket bilgileri ----
    match /gym_subscriptions/{tenantId} {
      allow read: if belongsToMyTenant(tenantId);
      allow create, update: if isAdmin() && tenantId == myTenantId() && request.resource.data.tenantId == tenantId;
      allow delete: if false;
    }

    // ---- gym_suppliers: tedarikçiler ----
    match /gym_suppliers/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    // ---- gym_supplier_categories: tedarikçi kategorileri ----
    match /gym_supplier_categories/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    // ---- einvoice_configs & einvoice_items: e-fatura entegrasyonu ----
    match /einvoice_configs/{tenantId} {
      allow read: if belongsToMyTenant(tenantId);
      allow create, update: if isAdmin() && tenantId == myTenantId() && request.resource.data.tenantId == tenantId;
      allow delete: if false;
    }

    match /einvoice_items/{docId} {
      allow read: if adminDoc();
      allow create: if adminCreate() || (isSignedIn() && request.resource.data.tenantId == myTenantId());
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    // ---- turnstile_gates: turnikeler ve donanım geçiş kapıları ----
    match /turnstile_gates/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    // ---- guest_members: misafir üyeler ve salon tanıtım kayıtları ----
    match /guest_members/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    // ---- gym_definitions: branş, donanım, bölgesel antrenman genel tanımları ----
    match /gym_definitions/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    // ---- accounting_categories: muhasebe gelir/gider kategorileri ----
    match /accounting_categories/{docId} {
      allow read: if belongsToMyTenant(resource.data.tenantId);
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }

    // ---- subscription_transfers: abonelik devir geçmişi ----
    match /subscription_transfers/{docId} {
      allow read: if adminDoc();
      allow create: if adminCreate();
      allow update: if adminDoc() && tenantUnchanged();
      allow delete: if adminDoc();
    }
  }
}

