{
  "name": "odivongym",
  "version": "1.0.3",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/write-version.mjs",
    "start": "ng serve --configuration development",
    "prebuild": "node scripts/write-version.mjs",
    "build": "ng build",
    "prewatch": "node scripts/write-version.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/write-version.mjs",
    "test": "ng test",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:cf": "npm run build && npx --yes wrangler@4 deploy",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "pack:agent": "cd edge-agent && rm -f ../public/downloads/odivon-gym-edge-agent.zip && zip -qr ../public/downloads/odivon-gym-edge-agent.zip agent.js package.json README.md baslat.bat servis-kur.bat config.sample.json src",
    "test:agent": "npm --prefix edge-agent test",
    "prepare": "node scripts/install-git-hooks.mjs",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.8",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@types/qrcode": "^1.5.6",
    "firebase": "^11.10.0",
    "heroicons": "^2.2.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/localize": "^20.3.31",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2"
  }
}
